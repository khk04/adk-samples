# OpenAI API 설정
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo-preview

# 시스템 설정
LOG_LEVEL=INFO
MAX_TOKENS=4000
TEMPERATURE=0.7
SYSTEM_PROMPT=You are a helpful AI assistant specialized in document analysis and report generation.

# 파일 처리 설정
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=pdf,docx,txt,html,md,csv,xlsx
UPLOAD_DIR=./uploads
TEMP_DIR=./temp

# 데이터베이스 설정 (선택사항)
DATABASE_URL=sqlite:///./doc_question_report.db

# 웹 서버 설정
HOST=0.0.0.0
PORT=8000
DEBUG=false

# 보안 설정
SECRET_KEY=your_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1

# 외부 API 설정
ANALYTICS_API_KEY=your_analytics_api_key_here
REPORTING_SERVICE_URL=https://api.reporting-service.com

# 모니터링 설정
ENABLE_METRICS=true
METRICS_PORT=9090