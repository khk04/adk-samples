# Python 3.11 slim 이미지 사용
FROM python:3.11-slim

# 작업 디렉토리 설정
WORKDIR /app

# 시스템 패키지 업데이트 및 필요한 패키지 설치
RUN apt-get update && apt-get install -y \
    curl \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# uv 설치
RUN pip install uv

# Python 의존성 파일 복사
COPY pyproject.toml uv.lock ./

# Python 의존성 설치
RUN uv sync --frozen

# 애플리케이션 코드 복사
COPY app/ ./app/
COPY data/ ./data/

# 로그 디렉토리 생성
RUN mkdir -p logs

# 포트 노출
EXPOSE 8000

# 환경 변수 설정
ENV PYTHONPATH=/app
ENV GOOGLE_GENAI_USE_VERTEXAI=FALSE

# 헬스체크 설정
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 애플리케이션 실행
CMD ["uv", "run", "adk", "api_server", "app", "--allow_origins=*", "--host", "0.0.0.0", "--port", "8000"]
