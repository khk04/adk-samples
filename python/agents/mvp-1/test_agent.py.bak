#!/usr/bin/env python3
"""
에이전트 테스트 스크립트
"""

import sys
import os
sys.path.append(os.path.dirname(os.path.abspath(__file__)))

from mvp_1.tools.data_validation_tool import validate_data
from mvp_1.tools.user_data_check_tool import check_user_data_request

def test_data_validation():
    """데이터 검증 테스트"""
    print("=== 데이터 검증 테스트 ===")
    
    # vdata 폴더 테스트
    result = validate_data(
        data_directory="data/vdata",
        required_columns=["월", "지역", "상품군", "매출액"],
        min_rows=1
    )
    
    print(f"성공: {result.success}")
    print(f"데이터 준비됨: {result.is_data_ready}")
    print(f"검증 요약: {result.validation_summary}")
    print(f"문제점: {result.issues}")
    print(f"권장사항: {result.recommendations}")
    
    if result.error_message:
        print(f"오류 메시지: {result.error_message}")
    
    return result

def test_user_data_check():
    """사용자 데이터 확인 테스트"""
    print("\n=== 사용자 데이터 확인 테스트 ===")
    
    result = check_user_data_request(
        user_request="vdata 폴더의 데이터를 확인해줘",
        data_directory="data/vdata"
    )
    
    print(f"성공: {result.success}")
    print(f"메시지: {result.message}")
    print(f"검증 필요: {result.should_validate}")
    print(f"검증 매개변수: {result.validation_params}")
    
    return result

if __name__ == "__main__":
    print("에이전트 도구 테스트 시작...\n")
    
    # 데이터 검증 테스트
    validation_result = test_data_validation()
    
    # 사용자 데이터 확인 테스트
    check_result = test_user_data_check()
    
    print("\n=== 테스트 완료 ===")
    print(f"데이터 검증: {'성공' if validation_result.success else '실패'}")
    print(f"사용자 확인: {'성공' if check_result.success else '실패'}")